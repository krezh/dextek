#!/usr/bin/env just --justfile

set quiet
set positional-arguments
set lazy

CLUSTER_DIR := "."
BOOTSTRAP_DIR := CLUSTER_DIR + "/bootstrap"
TALOS_CONTROLLER := "$(talosctl config info --output json | jq --raw-output '.endpoints[]' | shuf -n 1)"
CLUSTER_NAME := "dextek"

_default:
    just --list

[private]
step desc command:
    #!/usr/bin/env bash
    STEP_CMD={{ quote(command) }}
    gum spin --show-error --spinner dot --title "{{ desc }}" -- bash -c "$STEP_CMD" || exit 1
    printf '\r\e[2K\e[32m✓\e[0m %s\n' "{{ desc }}"

# Bootstrap all resources
all:
    #!/usr/bin/env bash
    set -euo pipefail
    gum confirm "Bootstrap cluster {{ CLUSTER_NAME }}?" || exit 0
    printf '%.0s─' $(seq 1 24); echo
    just tofu
    just talosconfig
    just talos
    just kubeconfig
    just readyCheck
    just namespaces
    just flux-secrets
    just crds
    just apps
    just wipe
    just status

tofu:
    #!/usr/bin/env bash
    init='cd "{{ CLUSTER_DIR }}/terraform/talos" && tofu init --upgrade'
    apply='cd "{{ CLUSTER_DIR }}/terraform/talos" && tofu apply --auto-approve --var talosconfig=true'
    just step "Initialising Tofu" "${init}"
    just step "Applying Tofu" "${apply}"
    mkdir -p ~/.talos/configs
    cp "{{ CLUSTER_DIR }}/terraform/talos/talosconfig" ~/.talos/configs/{{ CLUSTER_NAME }}

pulumi:
    #!/usr/bin/env bash
    init='cd "{{ CLUSTER_DIR }}/terraform/talos" && pulumi refresh --yes --non-interactive --skip-preview'
    apply='cd "{{ CLUSTER_DIR }}/terraform/talos" && pulumi up --yes --skip-preview'
    just step "Initialising Pulumi" "${init}"
    just step "Applying Pulumi" "${apply}"
    mkdir -p ~/.talos/configs
    cp "{{ CLUSTER_DIR }}/pulumi/talos/machineConfigs/talosconfig" ~/.talos/configs/{{ CLUSTER_NAME }}

talosconfig:
    #!/usr/bin/env bash
    cmd="talswitcher ctx {{ CLUSTER_NAME }}"
    just step "Switching talos context" "${cmd}"

talos:
    #!/usr/bin/env bash
    CTRL="{{ TALOS_CONTROLLER }}"
    cmd="until talosctl --nodes $CTRL bootstrap; do sleep 5; done"
    just step "Bootstrapping $CTRL" "${cmd}"

kubeconfig:
    #!/usr/bin/env bash
    CTRL="{{ TALOS_CONTROLLER }}"
    cmd="until talosctl kubeconfig -n $CTRL --force; do sleep 3; done && kubectl config set-cluster {{ CLUSTER_NAME }} --server https://$CTRL:6443"
    just step "Getting kubeconfig" "${cmd}"

readyCheck:
    #!/usr/bin/env bash
    cmd="until kubectl wait nodes --for=condition=Ready=False --all --timeout=10m; do sleep 5; done"
    just step "Waiting for nodes" "${cmd}"

namespaces:
    #!/usr/bin/env bash
    cmd='find apps -mindepth 1 -maxdepth 1 -type d | while IFS= read -r dir; do kustomize build "$dir" | yq ea -e '\''select(.kind == "Namespace")'\'' | kubectl apply --server-side --field-manager bootstrap --force-conflicts -f - 2>/dev/null || true; done'
    just step "Applying namespaces" "${cmd}"

flux-secrets:
    #!/usr/bin/env bash
    cmd="infisical export --template={{ BOOTSTRAP_DIR }}/resources.yaml.tmpl | kubectl apply -f -"
    just step "Applying Flux secrets" "${cmd}"

crds:
    #!/usr/bin/env bash
    cmd='attempt=0; until out=$(helmfile -f {{ BOOTSTRAP_DIR }}/helmfile.d/00-crds.yaml template -q 2>&1 | yq ea -e "select(.kind == \"CustomResourceDefinition\")" 2>&1 | kubectl apply --server-side --field-manager bootstrap --force-conflicts -f - 2>&1); do attempt=$((attempt+1)); echo "✗ CRD apply failed (attempt ${attempt}):"; echo "${out}"; sleep 3; done; echo "${out}"'
    just step "Applying CRDs" "${cmd}"

apps:
    #!/usr/bin/env bash
    cmd='attempt=0; until out=$(helmfile -f {{ BOOTSTRAP_DIR }}/helmfile.d/01-apps.yaml sync --hide-notes 2>&1); do attempt=$((attempt+1)); echo "✗ apps sync failed (attempt ${attempt}):"; echo "${out}"; sleep 3; done; echo "${out}"'
    just step "Deploying apps" "${cmd}"

helmfile: crds apps

# Wipe the non-system disks on every node, then reboot to drop stale LVM mappings
wipe:
    #!/usr/bin/env bash
    set -euo pipefail
    kubectl delete daemonset disk-wipe -n rook-ceph --ignore-not-found >/dev/null 2>&1
    apply="kubectl apply -f {{ BOOTSTRAP_DIR }}/wipe-daemonset.yaml"
    rollout="kubectl rollout status daemonset/disk-wipe -n rook-ceph --timeout=10m"
    just step "Applying wipe DaemonSet" "${apply}"
    just step "Wiping disks" "${rollout}"
    kubectl delete daemonset disk-wipe -n rook-ceph --ignore-not-found >/dev/null 2>&1
    # The DaemonSet clears the on-disk signatures, but the kernel holds on to the
    # ceph-* device-mapper mappings Talos auto-activated at boot until a reboot.
    just reboot
    just verify-wipe

# Reboot all nodes
reboot:
    #!/usr/bin/env bash
    set -euo pipefail
    NODES=$(talosctl config info --output json | jq --raw-output '.endpoints[]' | paste -sd,)
    talosctl --nodes "$NODES" reboot --wait=false
    down="for _ in \$(seq 60); do talosctl --nodes $NODES version >/dev/null 2>&1 || break; sleep 2; done"
    up="until talosctl --nodes $NODES version >/dev/null 2>&1; do sleep 5; done"
    ready="until kubectl wait nodes --all --for=condition=Ready --timeout=5m >/dev/null 2>&1; do sleep 5; done"
    just step "Rebooting nodes" "${down} && ${up}"
    just step "Waiting for nodes" "${ready}"

# Fail if any node still has leftover device-mapper volumes after a wipe
[private]
verify-wipe:
    #!/usr/bin/env bash
    set -euo pipefail
    NODES=$(talosctl config info --output json | jq --raw-output '.endpoints[]')
    rc=0
    for node in $NODES; do
      left=$(talosctl --nodes "$node" --endpoints "$node" get discoveredvolumes --output json \
        | jq --raw-output 'select(.metadata.id | startswith("dm-")) | .metadata.id' | tr '\n' ' ')
      if [[ -n "${left// /}" ]]; then
        printf '\e[31m✗\e[0m %s still has device-mapper volumes: %s\n' "$node" "$left"
        rc=1
      fi
    done
    if [[ $rc -eq 0 ]]; then
      printf '\e[32m✓\e[0m Disks wiped, no stale device-mapper volumes\n'
    fi
    exit $rc

status:
    #!/usr/bin/env bash
    LAYOUT=$(cat << 'EOF'
    layout {
        pane split_direction="vertical" {
            pane split_direction="horizontal" {
                pane {
                    command "kubectl"
                    args "klock" "-A" "ks"
                }
                pane {
                    command "kubectl"
                    args "klock" "-A" "pods" "--field-selector=status.phase!=Running,status.phase!=Succeeded"
                }
            }
            pane split_direction="horizontal" {
                pane {
                    command "kubectl"
                    args "klock" "-A" "hr"
                }
                pane {
                    command "kubectl"
                    args "klock" "-A" "events"
                }
            }
        }
    }
    EOF
    )
    nix run nixpkgs#zellij -- --layout-string "$LAYOUT"
