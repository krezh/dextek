{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Disable PostgreSQL major version updates",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/postgres"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },    
    {
      description: "Hold Rook-Ceph at v1.19.x",
      matchPackageNames: ["/rook-ceph/", "/rook-ceph-cluster/"],
      allowedVersions: "<1.20.0",
    },
    {
      description: "CoreDNS 1.14.3+ prefetch poisons autopath answers, hold until coredns/coredns#8390 is fixed",
      matchPackageNames: ["oci://ghcr.io/coredns/charts/coredns"],
      allowedVersions: "<1.47.0",
    },
  ],
}
